  "components": {
    "schemas": {
      "CreateDiagnostic": {
        "properties": {
          "mechanic": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Mechanic"
          },
          "summary": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Summary"
          },
          "obd_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Obd Codes"
          },
          "checklist": {
            "additionalProperties": true,
            "type": "object",
            "title": "Checklist"
          },
          "measurements": {
            "additionalProperties": true,
            "type": "object",
            "title": "Measurements"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "mechanic",
          "summary"
        ],
        "title": "CreateDiagnostic"
      },
      "CreateOrder": {
        "properties": {
          "customer_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer Id"
          },
          "vehicle_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Vehicle Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "vehicle_id",
          "items"
        ],
        "title": "CreateOrder"
      },
      "EnqueueExecution": {
        "properties": {
          "order_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Order Id"
          },
          "priority": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "order_id"
        ],
        "title": "EnqueueExecution"
      },
      "ExecutionCompletion": {
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Note",
            "default": "Serviço concluído"
          }
        },
        "type": "object",
        "title": "ExecutionCompletion"
      },
      "ExecutionStatusUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "title": "ExecutionStatusUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderItem": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "PART",
              "SERVICE"
            ],
            "title": "Kind",
            "default": "PART"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "OrderItem"
      },
      "PaymentConfirmed": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "payment_id": {
            "type": "string",
            "title": "Payment Id"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "payment_id"
        ],
        "title": "PaymentConfirmed"
      },
      "StatusChange": {
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "title": "StatusChange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
